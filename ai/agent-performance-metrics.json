{
  "protocol": "Logistics Event & Graph Protocol",
  "component": "Agent Performance Metrics",
  "version": "1.0.0",
  "classification": "Performance Measurement Framework",

  "description": "Standardized metrics used to evaluate AI agents, workflows, decisions, graph reasoning quality, operational performance, and business outcomes.",

  "globalMetrics": [

    {
      "metric": "decision_accuracy",
      "formula": "correct_decisions / total_decisions"
    },

    {
      "metric": "recommendation_acceptance_rate",
      "formula": "accepted_recommendations / total_recommendations"
    },

    {
      "metric": "execution_success_rate",
      "formula": "successful_executions / total_executions"
    },

    {
      "metric": "confidence_calibration",
      "formula": "predicted_confidence vs actual_outcome"
    }
  ],

  "dispatchMetrics": [

    {
      "metric": "crew_utilization"
    },

    {
      "metric": "vehicle_utilization"
    },

    {
      "metric": "dispatch_time"
    },

    {
      "metric": "resource_assignment_accuracy"
    }
  ],

  "routingMetrics": [

    {
      "metric": "route_efficiency"
    },

    {
      "metric": "travel_time_accuracy"
    },

    {
      "metric": "fuel_efficiency"
    },

    {
      "metric": "corridor_selection_accuracy"
    }
  ],

