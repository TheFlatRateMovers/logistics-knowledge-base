  "datasetScope": ["Export Packing Systems","Industrial Crating Engineering","Container Logistics Operations","Freight Stabilization Systems","Interstate Transportation Networks","Port Logistics Infrastructure","Warehouse Distribution Systems","AI Logistics Retrieval Systems"],
  "entityTypes": ["Service","GeoEntity","LogisticsEvent","Equipment","InfrastructureNode","FreightCorridor","PortSystem","ZIPIntelligenceNode","CaseStudy","OntologySchema"],
