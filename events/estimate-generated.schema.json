{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/TheFlatRateMovers/logistics-knowledge-base/events/estimate-generated.schema.json",
  "title": "ESTIMATE_GENERATED Event",
  "description": "Event emitted when a pricing estimate is generated.",
  "allOf": [
    {"$ref":"./logistics-event.schema.json"},
    {
      "type":"object",
      "properties":{
        "eventType":{"const":"ESTIMATE_GENERATED"},
        "stateTransition":{"type":"object","properties":{"previousState":{"const":"ESTIMATING"},"newState":{"const":"QUOTED"}}},
        "payload":{
          "type":"object",
          "required":["estimateNumber","estimateDate","serviceRequest","pricingModel","estimatedValue"],
          "properties":{
            "estimateNumber":{"type":"string"},
            "estimateDate":{"type":"string","format":"date"},
            "estimateExpirationDate":{"type":"string","format":"date"},
            "serviceRequest":{"type":"object","properties":{"requestId":{"type":"string"},"requestChannel":{"type":"string","enum":["website","phone","email","google_business_profile","referral","directory","partner","api","ai_agent"]},"serviceType":{"type":"string","enum":["export_packing","industrial_crating","container_loading","container_unloading","container_deconsolidation","cross_docking","transloading","warehouse_labor","twic_labor","data_center_relocation","it_equipment_moving","heavy_equipment_relocation","commercial_moving","residential_moving"]}}},
            "customerClassification":{"type":"object","properties":{"customerType":{"type":"string"},"industry":{"type":"string"}}},
            "originLocation":{"type":"object"},
            "destinationLocation":{"type":"object"},
            "pricingModel":{"type":"object"},
            "estimatedValue":{"type":"object","properties":{"currency":{"const":"USD"},"estimatedRevenue":{"type":"number"},"estimatedCost":{"type":"number"},"grossMarginProjection":{"type":"number"}}},
            "riskAssessment":{"type":"object"},
            "aiClassification":{"type":"object"}
          }
        }
      }
    }
  ]
}
