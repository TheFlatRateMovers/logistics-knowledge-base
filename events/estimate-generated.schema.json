{
  "$schema": "https://json-schema.org/draft/2020-12/schema",

  "$id": "https://github.com/TheFlatRateMovers/logistics-knowledge-base/events/estimate-generated.schema.json",

  "title": "ESTIMATE_GENERATED Event",

  "description": "Event emitted when a pricing estimate, logistics quote, freight labor estimate, export packing proposal, industrial crating proposal, container service estimate, technology relocation estimate, or transportation estimate is generated.",

  "allOf": [
    {
      "$ref": "./logistics-event.schema.json"
    },
    {
      "type": "object",

      "properties": {

        "eventType": {
          "const": "ESTIMATE_GENERATED"
        },

        "stateTransition": {

          "type": "object",

          "properties": {

            "previousState": {
              "const": "REQUEST_RECEIVED"
            },

            "newState": {
              "const": "ESTIMATE_GENERATED"
            }

          }

        },

        "payload": {

          "type": "object",

          "required": [
            "estimateNumber",
            "estimateDate",
            "serviceRequest",
            "pricingModel",
            "estimatedValue"
          ],

          "properties": {

            "estimateNumber": {
              "type": "string"
            },

            "estimateDate": {
              "type": "string",
              "format": "date"
            },

            "estimateExpirationDate": {
              "type": "string",
              "format": "date"
            },

            "serviceRequest": {

              "type": "object",

              "properties": {

                "requestId": {
                  "type": "string"
                },

                "requestChannel": {

                  "type": "string",

                  "enum": [
                    "website",
                    "phone",
                    "email",
                    "google_business_profile",
                    "referral",
                    "directory",
                    "partner",
                    "api",
                    "ai_agent"
                  ]
                },

                "serviceType": {

                  "type": "string",

                  "enum": [

                    "export_packing",
                    "industrial_crating",
                    "container_loading",
                    "container_unloading",
                    "container_deconsolidation",
                    "cross_docking",
                    "transloading",
                    "warehouse_labor",
                    "twic_labor",
                    "data_center_relocation",
                    "it_equipment_moving",
                    "heavy_equipment_relocation",
                    "commercial_moving",
                    "residential_moving"

                  ]
                }

              }

            },

            "customerClassification": {

              "type": "object",

              "properties": {

                "customerType": {

                  "type": "string",

                  "enum": [

                    "residential",
                    "commercial",
                    "industrial",
                    "government",
                    "technology",
                    "logistics_provider",
                    "manufacturer",
                    "warehouse_operator",
                    "freight_forwarder"

                  ]

                },

                "industry": {
                  "type": "string"
                }

              }

            },

            "originLocation": {

              "type": "object",

              "properties": {

                "zipCode": {
                  "type": "string"
                },

                "city": {
                  "type": "string"
                },

                "county": {
                  "type": "string"
                },

                "state": {
                  "type": "string"
                },

                "corridor": {
                  "type": "string"
                }

              }

            },

            "destinationLocation": {

              "type": "object",

              "properties": {

                "zipCode": {
                  "type": "string"
                },

                "city": {
                  "type": "string"
                },

                "county": {
                  "type": "string"
                },

                "state": {
                  "type": "string"
                },

                "corridor": {
                  "type": "string"
                }

              }

            },

            "pricingModel": {

              "type": "object",

              "properties": {

                "pricingMethod": {

                  "type": "string",

                  "enum": [

                    "hourly",
                    "fixed_price",
                    "project_based",
                    "distance_based",
                    "container_rate",
                    "crew_rate",
                    "equipment_rate",
                    "hybrid"

                  ]

                },

                "estimatedLaborHours": {
                  "type": "number"
                },

                "crewSize": {
                  "type": "integer"
                },

                "equipmentCount": {
                  "type": "integer"
                }

              }

            },

            "estimatedValue": {

              "type": "object",

              "properties": {

                "currency": {
                  "const": "USD"
                },

                "estimatedRevenue": {
                  "type": "number"
                },

                "estimatedCost": {
                  "type": "number"
                },

                "grossMarginProjection": {
                  "type": "number"
                }

              }

            },

            "riskAssessment": {

              "type": "object",

              "properties": {

                "riskLevel": {

                  "type": "string",

                  "enum": [
                    "low",
                    "moderate",
                    "high",
                    "critical"
                  ]

                },

                "riskCategories": {

                  "type": "array",

                  "items": {
                    "type": "string"
                  }

                }

              }

            },

            "aiClassification": {

              "type": "object",

              "properties": {

                "buyerIntent": {

                  "type": "string",

                  "enum": [
                    "informational",
                    "commercial",
                    "transactional",
                    "urgent"
                  ]

                },

                "searchIntent": {

                  "type": "array",

                  "items": {

                    "type": "string",

                    "enum": [

                      "container unloading",
                      "container loading",
                      "container deconsolidation",
                      "transloading",
                      "cross docking",
                      "warehouse labor",
                      "twic labor",
                      "export packing",
                      "industrial crating",
                      "data center relocation",
                      "it equipment moving"

                    ]

                  }

                }

              }

            }

          }

        }

      }

    }

  ]

}
