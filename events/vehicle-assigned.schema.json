{
  "$schema": "https://json-schema.org/draft/2020-12/schema",

  "$id": "https://github.com/TheFlatRateMovers/logistics-knowledge-base/events/vehicle-assigned.schema.json",

  "title": "VEHICLE_ASSIGNED Event",

  "description": "Event emitted when transportation assets are assigned to a logistics operation, shipment, relocation project, freight movement, warehouse operation, technology relocation, container handling project, or export packing workflow.",

  "allOf": [
    {
      "$ref": "./logistics-event.schema.json"
    },
    {
      "type": "object",

      "properties": {

        "eventType": {
          "const": "VEHICLE_ASSIGNED"
        },

        "stateTransition": {

          "type": "object",

          "properties": {

            "previousState": {
              "const": "JOB_CREATED"
            },

            "newState": {
              "const": "VEHICLE_ASSIGNED"
            }

          }

        },

        "payload": {

          "type": "object",

          "required": [
            "jobNumber",
            "vehicleAssignment",
            "crewAssignment"
          ],

          "properties": {

            "jobNumber": {
              "type": "string"
            },

            "dispatchTimestamp": {
              "type": "string",
              "format": "date-time"
            },

            "vehicleAssignment": {

              "type": "object",

              "properties": {

                "vehicleId": {
                  "type": "string"
                },

                "vehicleClass": {

                  "type": "string",

                  "enum": [

                    "cargo_van",
                    "box_truck",
                    "straight_truck",
                    "tractor_trailer",
                    "flatbed",
                    "liftgate_truck",
                    "equipment_trailer",
                    "technology_transport_vehicle"

                  ]

                },

                "vehicleCapacity": {
                  "type": "number"
                },

                "liftgateEquipped": {
                  "type": "boolean"
                },

                "gpsEnabled": {
                  "type": "boolean"
                }

              }

            },

            "crewAssignment": {

              "type": "object",

              "properties": {

                "crewSize": {
                  "type": "integer"
                },

                "crewClassification": {

                  "type": "array",

                  "items": {

                    "type": "string",

                    "enum": [

                      "driver",
                      "crew_leader",
                      "warehouse_labor",
                      "twic_labor",
                      "forklift_operator",
                      "rigging_specialist",
                      "server_relocation_specialist",
                      "export_packing_specialist",
                      "industrial_crating_specialist"

                    ]

                  }

                }

              }

            },

            "equipmentAssignment": {

              "type": "array",

              "items": {

                "type": "object",

                "properties": {

                  "equipmentType": {

                    "type": "string",

                    "enum": [

                      "forklift",
                      "pallet_jack",
                      "container_ramp",
                      "gantry",
                      "server_cart",
                      "rack_lift",
                      "stair_climber",
                      "liftgate",
                      "crane",
                      "cargo_bars",
                      "load_straps",
                      "shock_monitor",
                      "anti_static_packaging"

                    ]

                  },

                  "quantity": {
                    "type": "integer"
                  }

                }

              }

            },

            "routeAssignment": {

              "type": "object",

              "properties": {

                "primaryCorridor": {

                  "type": "string",

                  "enum": [

                    "I-81",
                    "I-66",
                    "I-70",
                    "I-68",
                    "I-270",
                    "I-95"

                  ]

                },

                "estimatedMileage": {
                  "type": "number"
                },

                "estimatedTravelHours": {
                  "type": "number"
                }

              }

            },

            "portConnectivity": {

              "type": "object",

              "properties": {

                "relatedPort": {

                  "type": "string",

                  "enum": [

                    "Port of Virginia",
                    "Virginia Inland Port",
                    "Port of Baltimore",
                    "None"

                  ]

                },

                "portWorkflowType": {

                  "type": "string",

                  "enum": [

                    "container_loading",
                    "container_unloading",
                    "container_deconsolidation",
                    "transloading",
                    "cross_docking",
                    "none"

                  ]

                }

              }

            }

          }

        }

      }

    }

  ]

}
